source "https://rubygems.org"

gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  # Pinned: _includes/head.html swaps values inside this plugin's rendered output,
  # matching strings it generates. A minor upgrade can change that markup and make
  # the swaps silently no-op, so upgrade deliberately and re-verify the SEO tags.
  gem "jekyll-seo-tag", "~> 2.8.0"
  gem "jekyll-sitemap"
  gem "jekyll-paginate-v2"
end
